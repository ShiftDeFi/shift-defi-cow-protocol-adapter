# Compiler files
cache/
out/

# Gate reports (regenerated by `make verify`). The triage files next to them —
# aderyn.triage, slither.db.json — are REVIEWED STATE and ARE committed.
slither.out.json
aderyn.out.json

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs
docs/

# Dotenv file
.env

# Per-developer agent settings. The committed .claude/settings.json carries the
# shared hooks; this file is each developer's own override and stays untracked.
.claude/settings.local.json

# Byte-compiled gate scripts and hooks. retriage_aderyn.py imports gate_aderyn
# for the gating rules, and the hooks import wall_protected for the protected
# path list; both write a cache next to the source.
script/__pycache__/
.claude/hooks/__pycache__/

# Coverage
lcov.info
